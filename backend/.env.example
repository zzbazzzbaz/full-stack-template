APP_NAME=backend
DATABASE_URL=postgresql+asyncpg://user:pw@localhost:5432/db
JWT_SECRET=change-me-in-production-min-32-bytes!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
